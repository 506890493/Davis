// service_test.go.tmpl
// Standard table-driven test pattern for Service layer
// Adjust mock paths and test cases according to your needs

package myservice

import (
	"context"
	"errors"
	"testing"

	"github.com/stretchr/testify/assert"
	"go.uber.org/mock/gomock"

	"source.golabs.io/fleet/fleet-backend/repository/mocks"
)

func TestMyService_MethodName(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	mockRepo := mocks.NewMockMyRepository(ctrl)
	svc := NewMyService(mockRepo)

	tests := []struct {
		name        string
		setupMock   func()
		input       MyInput
		wantResult  *MyResult
		wantErr     bool
		errMatch    string // Optional: error message substring to match
	}{
		{
			name: "success case",
			setupMock: func() {
				mockRepo.EXPECT().
					SomeMethod(gomock.Any(), gomock.Any()).
					Return(&repository.SomeModel{Id: 1}, nil).
					Times(1)
			},
			input:      MyInput{Field: "value"},
			wantResult: &MyResult{Id: 1},
			wantErr:    false,
		},
		{
			name: "repository error propagates",
			setupMock: func() {
				mockRepo.EXPECT().
					SomeMethod(gomock.Any(), gomock.Any()).
					Return(nil, errors.New("database connection failed")).
					Times(1)
			},
			input:      MyInput{Field: "value"},
			wantResult: nil,
			wantErr:    true,
			errMatch:   "database connection failed",
		},
		{
			name: "validation error",
			setupMock: func() {
				// No mock setup — should fail before calling repo
			},
			input:      MyInput{Field: ""}, // Invalid input
			wantResult: nil,
			wantErr:    true,
			errMatch:   "field is required",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			tt.setupMock()

			result, err := svc.MethodName(context.Background(), tt.input)

			if tt.wantErr {
				assert.Error(t, err)
				if tt.errMatch != "" {
					assert.Contains(t, err.Error(), tt.errMatch)
				}
				assert.Nil(t, result)
			} else {
				assert.NoError(t, err)
				assert.NotNil(t, result)
				assert.Equal(t, tt.wantResult, result)
			}
		})
	}
}
