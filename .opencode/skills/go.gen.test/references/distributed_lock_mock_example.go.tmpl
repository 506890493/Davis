			ctx,
			"driver-transaction-lock",
			lock.WithMutexLockValue(strconv.FormatInt(driverID, 10)),
		)

		lockErr = ln.LockContext(ctx)
		if lockErr == nil {
			// 锁获取成功
			return ln, nil
		}

