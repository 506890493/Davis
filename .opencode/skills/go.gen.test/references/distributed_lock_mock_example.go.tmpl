// distributed_lock_mock_example.go.tmpl
// 分布式锁 Mock 测试示例
//
// 本文件展示如何在测试中正确 Mock 分布式锁，避免触发生产代码的
// 重试延迟（1s + 2s + 4s = 7秒），将测试时间从 7 秒降至 3ms。

package main

import (
	"context"
	"errors"
	"testing"

	. "github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"
	"go.uber.org/mock/gomock"
	"source.golabs.io/fleet/fleet-backend/service/lock"
)

// ============================================================================
// 问题描述
// ============================================================================
//
// 生产代码在获取锁失败时会重试 3 次，每次失败后等待：
//   - 第 1 次失败：等待 1 秒
//   - 第 2 次失败：等待 2 秒
//   - 第 3 次失败：等待 4 秒
//   - 总计：7 秒
//
// 如果在测试中 Mock 锁获取失败，使用普通 error 会触发这个重试逻辑，
// 导致单个测试耗时 7+ 秒。

// ============================================================================
// ❌ 错误示例：使用普通 error（会导致 7 秒延迟）
// ============================================================================

func TestLockAcquisition_WrongWay(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	mockLock := lock.NewMockDistributedLock(ctrl)
	mockMutex := lock.NewMockMutex(ctrl)

	// ❌ 错误：使用普通 error，会触发重试延迟
	mockLock.EXPECT().NewMutexWithOptions(gomock.Any(), gomock.Any()).
		Return(mockMutex).AnyTimes()

	mockMutex.EXPECT().LockContext(gomock.Any()).
		Return(errors.New("lock failed")).AnyTimes() // ❌ 会导致 7 秒延迟

	// 测试代码...
	// 这个测试会花费 7+ 秒
}

// ============================================================================
// ✅ 正确示例：使用 lock.ErrLockFailFast（立即失败，3ms）
// ============================================================================

func TestLockAcquisition_CorrectWay(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	mockLock := lock.NewMockDistributedLock(ctrl)
	mockMutex := lock.NewMockMutex(ctrl)

	// ✅ 正确：使用 lock.ErrLockFailFast，跳过重试延迟
	mockLock.EXPECT().NewMutexWithOptions(gomock.Any(), gomock.Any()).
		Return(mockMutex).AnyTimes()

	mockMutex.EXPECT().LockContext(gomock.Any()).
		Return(lock.ErrLockFailFast).Times(1) // ✅ 只调用 1 次，立即失败

	// 测试代码...
	// 这个测试只需要 3ms
}

// ============================================================================
// 生产代码处理逻辑（参考）
// ============================================================================

// 以下是生产代码如何处理 lock.ErrLockFailFast 的示例：

/*
