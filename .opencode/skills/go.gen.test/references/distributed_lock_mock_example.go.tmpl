*/

// ============================================================================
// lock.ErrLockFailFast 定义（参考）
// ============================================================================

/*
package lock

import "errors"

// ErrLockFailFast signals to skip retry delays in lock acquisition
// Used in tests to avoid 7-second wait time (1s + 2s + 4s)
var ErrLockFailFast = errors.New("lock acquisition failed (fail-fast mode)")
*/

// ============================================================================
// Ginkgo 测试示例
// ============================================================================

var _ = ginkgo.Describe("DriverTransactionService", func() {
	var (
		ctrl      *gomock.Controller
		mockLock  *lock.MockDistributedLock
		mockMutex *lock.MockMutex
		svc       *DriverTransactionService
	)

	ginkgo.BeforeEach(func() {
		ctrl = gomock.NewController(ginkgo.GinkgoT())
		mockLock = lock.NewMockDistributedLock(ctrl)
		mockMutex = lock.NewMockMutex(ctrl)
		svc = NewDriverTransactionService(mockLock)
	})

	ginkgo.AfterEach(func() {
		ctrl.Finish()
	})

	ginkgo.Context("lock acquisition failures", func() {
		ginkgo.It("returns error immediately when lock fails (fast-fail)", func() {
			ginkgo.GinkgoHelper()

			// ✅ 使用 ErrLockFailFast，测试只需 3ms
			mockLock.EXPECT().NewMutexWithOptions(gomock.Any(), gomock.Any()).
				Return(mockMutex).Times(1)

			mockMutex.EXPECT().LockContext(gomock.Any()).
				Return(lock.ErrLockFailFast).Times(1)

			err := svc.ProcessDriverTransaction(context.Background(), int64(123))

			Expect(err).To(MatchError(lock.ErrLockFailFast))
		})
	})

	ginkgo.Context("lock acquisition success", func() {
		ginkgo.It("processes transaction when lock acquired successfully", func() {
			ginkgo.GinkgoHelper()

			// Mock 锁获取成功
			mockLock.EXPECT().NewMutexWithOptions(gomock.Any(), gomock.Any()).
				Return(mockMutex).Times(1)

			mockMutex.EXPECT().LockContext(gomock.Any()).
				Return(nil).Times(1) // nil 表示成功

			mockMutex.EXPECT().UnlockContext(gomock.Any()).
				Return(nil).Times(1) // 处理完成后释放锁

			err := svc.ProcessDriverTransaction(context.Background(), int64(123))

			Expect(err).NotTo(HaveOccurred())
		})
	})
})

// ============================================================================
// 适用场景总结
// ============================================================================

/*
| 场景 | LockContext 返回值 | 原因 |
|------|-------------------|------|
| 测试锁获取成功 | nil | 模拟正常流程 |
| 测试锁获取失败 | lock.ErrLockFailFast | 避免等待重试（7秒→3ms） |
| 测试业务逻辑（不涉及锁） | 使用 mock 锁返回 nil | 隔离依赖 |

性能对比：
- 使用普通 error：~7秒（触发生产代码重试延迟）
- 使用 ErrLockFailFast：~3ms（立即失败，跳过延迟）
- 性能提升：2333x
*/
