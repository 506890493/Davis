// This provides a local in-memory AES implementation — no Vault connection or KUBE_TOKEN required.

// inMemKeyStore is an in-memory implementation of
// gocipher.RecommendedKeyStorage[repository.CipherKey].
type inMemKeyStore struct {
    mu   sync.RWMutex
    keys []repository.CipherKey
}

func (s *inMemKeyStore) ReadAll() ([]repository.CipherKey, error) {
    s.mu.RLock()
    defer s.mu.RUnlock()
    out := make([]repository.CipherKey, len(s.keys))
    copy(out, s.keys)
    return out, nil
}

func (s *inMemKeyStore) Store(scope string, value []byte) (uint32, error) {
    s.mu.Lock()
    defer s.mu.Unlock()
    var maxVersion int64
    for _, k := range s.keys {
        if k.Scope == scope && k.Version > maxVersion {
            maxVersion = k.Version
        }
    }
    id := uint32(len(s.keys)) + 1
    s.keys = append(s.keys, repository.CipherKey{
        ID:        id,
        Scope:     scope,
        Version:   maxVersion + 1,
        Key:       value,
        CreatedAt: time.Now(),
    })
    return id, nil
}

// aesKeyCryptographer adapts gocipher.Cryptographer to gocipher.KeyCryptographer.
type aesKeyCryptographer struct{ c gocipher.Cryptographer }

func (a *aesKeyCryptographer) Encrypt(plaintext []byte) ([]byte, error) {
    return a.c.Encrypt(nil, plaintext)
}
func (a *aesKeyCryptographer) Decrypt(ciphertext []byte) ([]byte, error) {
    return a.c.Decrypt(nil, ciphertext)
}

// buildLocalCipher returns a *gocipher.Cipher backed by a freshly generated
// in-memory AES key. No Vault connection or KUBE_TOKEN is required.
func buildLocalCipher(cryptoScopes, digestScopes []string) (*gocipher.Cipher, error) {
    aesKey, err := gocipher.NewAESKey()
    if err != nil {
        return nil, err
    }
    wrapper, err := gocipher.NewAESWrapper(aesKey)
    if err != nil {
        return nil, err
    }
    keyCipher := &aesKeyCryptographer{c: wrapper}
    return gocipher.NewCipher(
        gocipher.WithCryptographerScopes(cryptoScopes...),
        gocipher.WithDigesterScopes(digestScopes...),
        gocipher.WithCryptographerRecommendedSecretKeyStore[repository.CipherKey](&inMemKeyStore{}),
        gocipher.WithDigesterRecommendedSecretKeyStore[repository.CipherKey](&inMemKeyStore{}),
        gocipher.WithCryptographerSecretKeyCipher(keyCipher),
        gocipher.WithDigesterSecretKeyCipher(keyCipher),
    )
}

// localCipherSvc wraps *gocipher.Cipher and implements cipher.CipherService.
type localCipherSvc struct{ ci *gocipher.Cipher }

func (s *localCipherSvc) Encrypt(_ context.Context, scope string, value []byte) ([]byte, error) {
    return s.ci.Encrypt(scope, value)
}
func (s *localCipherSvc) Decrypt(_ context.Context, scope string, value []byte) (string, error) {
    b, err := s.ci.Decrypt(scope, value)
    return string(b), err
}
func (s *localCipherSvc) Digest(_ context.Context, scope string, value []byte) ([]byte, error) {
    return s.ci.Digest(scope, value)
}
func (s *localCipherSvc) EncryptField(_ context.Context, _, _ string, _ string, _ map[string]interface{}) error {
    return nil
}
func (s *localCipherSvc) DecryptField(_ context.Context, _, _ string, _ []byte) (string, error) {
    return "", nil
}
