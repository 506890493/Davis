// handler_test_examples.go.tmpl
// Handler 层测试示例
//
// Fleet 后端存在两种 Handler 返回风格：
// 1. 返回值型：func (h *Handler) Method(r *http.Request) (Result, error)
// 2. 标准 HTTP 型：func (h *Handler) Method(w http.ResponseWriter, r *http.Request)
//
// 本文件展示两种类型的测试方式。

package main

import (
	"context"
	"errors"
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/gorilla/mux"
	. "github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/mock"
	"go.uber.org/mock/gomock"

	"source.golabs.io/fleet/fleet-backend/auth/jwt"
	"source.golabs.io/fleet/fleet-backend/service"
)

// ============================================================================
// 类型 1：返回值型 Handler 测试
// ============================================================================
//
// 特点：Handler 方法返回 (Result, error)
// 测试方式：直接调用方法，断言返回值

func TestXxxHandler_GetValue_ReturnType(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	// Mock Service 层
	mockSvc := service.NewMockXxxService(ctrl)
	handler := NewXxxHandler(mockSvc)

	tests := []struct {
		name      string
		setupMock func()
		wantErr   bool
		errMatch  string // Optional: error message substring to match
	}{
		{
			name: "success - returns value",
			setupMock: func() {
				mockSvc.EXPECT().GetValue(gomock.Any(), gomock.Any()).
					Return(&service.SomeResult{Id: 1, Value: "test"}, nil).
					Times(1)
			},
			wantErr: false,
		},
		{
			name: "service error - propagates to caller",
			setupMock: func() {
				mockSvc.EXPECT().GetValue(gomock.Any(), gomock.Any()).
					Return(nil, errors.New("database connection failed")).
					Times(1)
			},
			wantErr:  true,
			errMatch: "database connection failed",
		},
		{
			name: "validation error - empty parameter",
			setupMock: func() {
				// No mock setup — should fail before calling service
			},
			wantErr:  true,
			errMatch: "parameter is required",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			tt.setupMock()

			// 直接调用 Handler 方法
			req := httptest.NewRequest("GET", "/api/value?id=123", nil)
			result, err := handler.GetValue(req)

			if tt.wantErr {
				assert.Error(t, err)
				if tt.errMatch != "" {
					assert.Contains(t, err.Error(), tt.errMatch)
				}
				assert.Nil(t, result)
			} else {
				assert.NoError(t, err)
				assert.NotNil(t, result)
				assert.Equal(t, int64(1), result.Id)
				assert.Equal(t, "test", result.Value)
			}
		})
	}
}

// ============================================================================
// 类型 2：标准 HTTP 型 Handler 测试
// ============================================================================
//
// 特点：Handler 方法签名符合 http.HandlerFunc
// 测试方式：使用 httptest.NewRecorder() 捕获 HTTP 响应

func TestXxxHandler_GetDetail_HTTPType(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	// Mock Service 层
	mockSvc := service.NewMockXxxService(ctrl)
	handler := NewXxxHandler(mockSvc)

	tests := []struct {
		name           string
		setupMock      func()
		urlVars        map[string]string // Gorilla Mux 路由参数
		queryParams    string            // URL query string
		expectedStatus int
		expectedBody   map[string]interface{}
	}{
		{
			name: "success - returns user detail",
			setupMock: func() {
				mockSvc.EXPECT().GetDetail(gomock.Any(), int64(1)).
					Return(&service.UserDetail{
						Id:    1,
						Name:  "John Doe",
						Email: "john@example.com",
					}, nil).
					Times(1)
			},
			urlVars:        map[string]string{"id": "1"},
			expectedStatus: http.StatusOK,
			expectedBody: map[string]interface{}{
				"id":    float64(1), // JSON unmarshal returns float64 for numbers
				"name":  "John Doe",
				"email": "john@example.com",
			},
		},
		{
			name: "not found - user does not exist",
			setupMock: func() {
				mockSvc.EXPECT().GetDetail(gomock.Any(), int64(999)).
					Return(nil, errors.New("user not found")).
					Times(1)
			},
			urlVars:        map[string]string{"id": "999"},
			expectedStatus: http.StatusNotFound,
		},
		{
			name: "service error - returns 500",
			setupMock: func() {
				mockSvc.EXPECT().GetDetail(gomock.Any(), gomock.Any()).
					Return(nil, errors.New("internal error")).
					Times(1)
			},
			urlVars:        map[string]string{"id": "1"},
			expectedStatus: http.StatusInternalServerError,
		},
		{
			name: "validation error - invalid id format",
			setupMock: func() {
				// No mock setup — should fail before calling service
			},
			urlVars:        map[string]string{"id": "invalid"},
			expectedStatus: http.StatusBadRequest,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			tt.setupMock()

			// 构造请求
			req := httptest.NewRequest("GET", "/api/detail"+tt.queryParams, nil)

			// 设置路由参数（Gorilla Mux）
			if len(tt.urlVars) > 0 {
				req = mux.SetURLVars(req, tt.urlVars)
			}

			// 捕获响应
			w := httptest.NewRecorder()

			// 调用 Handler
			handler.GetDetail(w, req)

			// 断言状态码
			assert.Equal(t, tt.expectedStatus, w.Code)

			// 如果成功，断言响应体（可选）
			if tt.expectedStatus == http.StatusOK && tt.expectedBody != nil {
				// 解析 JSON 并断言（示例代码，实际需要根据响应格式调整）
				// var body map[string]interface{}
				// err := json.Unmarshal(w.Body.Bytes(), &body)
				// assert.NoError(t, err)
				// assert.Equal(t, tt.expectedBody, body)
			}
		})
	}
}

// ============================================================================
// JWT Claims 注入
// ============================================================================
//
// 部分受保护的 Handler 方法接受 jwt.TokenClaim 参数，
// 测试时直接构造传入即可。

func TestXxxHandler_UpdateProfile_Authenticated(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	mockSvc := service.NewMockXxxService(ctrl)
	handler := NewXxxHandler(mockSvc)

	t.Run("success - authenticated user", func(t *testing.T) {
		// Mock Service
		mockSvc.EXPECT().UpdateProfile(gomock.Any(), int64(123), gomock.Any()).
			Return(&service.User{Id: 123, Name: "Updated Name"}, nil).
			Times(1)

		// 构造 JWT Claims
		claims := jwt.TokenClaim{
			Info: jwt.Info{
				UserId:   int64(123),
				Username: "testuser",
			},
		}

		// 构造请求
		req := httptest.NewRequest("PUT", "/api/profile", nil)
		req.Header.Set("Content-Type", "application/json")

		// 直接调用 Handler 方法，传入 claims
		result, err := handler.UpdateProfile(req, claims)

		assert.NoError(t, err)
		assert.NotNil(t, result)
		assert.Equal(t, int64(123), result.Id)
		assert.Equal(t, "Updated Name", result.Name)
	})
}

// ============================================================================
// Ginkgo 测试示例（标准 HTTP 型）
// ============================================================================

var _ = ginkgo.Describe("UserHandler (HTTP Type)", func() {
	var (
		ctrl    *gomock.Controller
		mockSvc *service.MockUserService
		handler *UserHandler
	)

	ginkgo.BeforeEach(func() {
		ctrl = gomock.NewController(ginkgo.GinkgoT())
		mockSvc = service.NewMockUserService(ctrl)
		handler = NewUserHandler(mockSvc)
	})

	ginkgo.AfterEach(func() {
		ctrl.Finish()
	})

	ginkgo.Context("GET /users/:id", func() {
		ginkgo.It("returns user when found", func() {
			ginkgo.GinkgoHelper()

			// Mock Service
			mockSvc.EXPECT().GetByID(gomock.Any(), int64(1)).
				Return(&service.User{
					Id:    1,
					Name:  "Test User",
					Email: "test@example.com",
				}, nil).
				Times(1)

			// 构造请求
			req := httptest.NewRequest("GET", "/users/1", nil)
			req = mux.SetURLVars(req, map[string]string{"id": "1"})

			// 捕获响应
			w := httptest.NewRecorder()

			// 调用 Handler
			handler.GetUser(w, req)

			// 断言
			Expect(w.Code).To(Equal(http.StatusOK))
			// 可选：进一步断言响应体
		})

		ginkgo.It("returns 404 when user not found", func() {
			ginkgo.GinkgoHelper()

			// Mock Service
			mockSvc.EXPECT().GetByID(gomock.Any(), int64(999)).
				Return(nil, errors.New("user not found")).
				Times(1)

			// 构造请求
			req := httptest.NewRequest("GET", "/users/999", nil)
			req = mux.SetURLVars(req, map[string]string{"id": "999"})

			// 捕获响应
			w := httptest.NewRecorder()

			// 调用 Handler
			handler.GetUser(w, req)

			// 断言
			Expect(w.Code).To(Equal(http.StatusNotFound))
		})
	})
})

// ============================================================================
// 关键注意事项
// ============================================================================

/*
1. Handler 类型判断
   - 生成前先读取目标文件确认 Handler 类型
   - 返回值型：直接调用，断言返回值
   - 标准 HTTP 型：使用 httptest.NewRecorder()

2. 路由参数（Gorilla Mux）
   - 使用 mux.SetURLVars(req, vars) 设置路由参数
   - 示例：req = mux.SetURLVars(req, map[string]string{"id": "123"})

3. JWT Claims
   - 直接构造 jwt.TokenClaim 传入
   - 示例：claims := jwt.TokenClaim{Info: jwt.Info{UserId: int64(1)}}

4. Query 参数
   - 在 URL 中构造：httptest.NewRequest("GET", "/api/users?page=1", nil)

5. 请求体
   - 使用 io.Reader：httptest.NewRequest("POST", "/api/users", bytes.NewReader(body))

6. Mock Service
   - 使用 gomock.Mock 接口
   - 设置期望：mockSvc.EXPECT().Method(gomock.Any(), params).Return(result, err)
*/
