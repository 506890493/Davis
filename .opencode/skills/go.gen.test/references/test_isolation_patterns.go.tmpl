// test_isolation_patterns.go.tmpl
// 测试隔离模式 - Ginkgo + PostgreSQL 事务回滚
//
// 本文件展示两种主要的测试隔离模式，确保每个测试用例（It块）
// 在独立的数据库事务中运行，AfterEach回滚保证数据完全隔离。

package main

import (
	"context"

	"github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"
	"go.uber.org/mock/gomock"
	"gorm.io/gorm"
	"source.golabs.io/fleet/fleet-backend/client/gormclient"
	"source.golabs.io/fleet/fleet-backend/repository/query"
)

// ============================================================================
// 模式一：Repository 直接注入 *gorm.DB
// ============================================================================
// 适用场景：Repository 构造函数直接接收 *gorm.DB 参数
//
// 示例 Repository：
//   type VehicleRepository struct {
//       db *gorm.DB
//   }
//
//   func NewVehicleRepository(db *gorm.DB) *VehicleRepository {
//       return &VehicleRepository{db: db}
//   }

var _ = ginkgo.Describe("VehicleRepository (Direct DB Injection)", func() {
	var (
		repo MyRepository
		tx   *gorm.DB
		ctrl *gomock.Controller
	)

	ginkgo.BeforeEach(func() {
		ginkgo.GinkgoHelper()

		// 启动事务
		tx = gormclient.GetDB(context.Background()).Begin()

		// 创建 Repository，直接注入事务连接
		repo = NewMyRepository(tx)

		// 创建 Mock Controller（如果需要 Mock 第三方服务）
		ctrl = gomock.NewController(ginkgo.GinkgoT())
	})

	ginkgo.AfterEach(func() {
		// 回滚事务，清理所有测试数据
		if tx != nil {
			_ = tx.Rollback()
		}

		// 完成 Mock 验证
		if ctrl != nil {
			ctrl.Finish()
		}
	})

	ginkgo.It("creates vehicle successfully", func() {
		ginkgo.GinkgoHelper()

		// 测试代码...
		_ = repo
	})
})

// ============================================================================
// 模式二：Repository 通过 *query.Query 参数接收 DB（q 参数传入式）
// ============================================================================
// 适用场景：Repository 构造函数不接收 *gorm.DB，而是每次调用时传入 *query.Query
//
// 示例 Repository：
//   type UserCipherDomainRepository struct {
//       cipherSvc cipher.CipherService
//   }
//
//   func (r *UserCipherDomainRepository) FindByID(
//       ctx context.Context,
//       q *query.Query,  // DB 连接通过参数传入
//       userID int64,
//   ) (*entity.User, error) {
//       u := q.User
//       m, err := u.WithContext(ctx).Where(u.ID.Eq(int32(userID))).First()
//       // ...
//   }

var _ = ginkgo.Describe("UserCipherDomainRepository (Query Parameter)", func() {
	var (
		testRepo domainRepo.MyRepository
		testCtx  context.Context
		testTx   *gorm.DB
		testQ    *query.Query
		cipherSvc cipher.CipherService
		ctrl     *gomock.Controller
	)

	ginkgo.BeforeEach(func() {
		ginkgo.GinkgoHelper()

		// 1. 初始化 Context
		testCtx = context.Background()

		// 2. 启动事务
		testTx = gormclient.GetDB(testCtx).Begin()

		// 3. 创建 Query 对象（包含事务连接）
		testQ = query.Use(testTx)

		// 4. 创建 Cipher 服务（本地 in-memory AES 实现）
		// 见 references/cipher_test_helper.go.tmpl
		cipherSvc = buildLocalCipher()

		// 5. 创建 Repository（不传入 DB，DB 通过 testQ 在调用时传入）
		testRepo = NewMyRepository(cipherSvc)

		// 6. 创建 Mock Controller（如果需要 Mock 第三方服务）
		ctrl = gomock.NewController(ginkgo.GinkgoT())
	})

	ginkgo.AfterEach(func() {
		// 回滚事务，清理所有测试数据
		if testTx != nil {
			_ = testTx.Rollback()
		}

		// 完成 Mock 验证
		if ctrl != nil {
			ctrl.Finish()
		}
	})

	ginkgo.Context("FindByID", func() {
		ginkgo.It("returns user by ID", func() {
			ginkgo.GinkgoHelper()

			// 测试代码...
			// 调用 Repository 方法时传入 testQ
			// user, err := testRepo.FindByID(testCtx, testQ, userID)
			_ = testRepo
			_ = testQ
		})
	})
})

// ============================================================================
// 关键注意事项
// ============================================================================

// ⚠️ UnderlyingDB() 事务穿透陷阱
//
// 如果 Repository 实现内部调用了 q.SomeModel.WithContext(ctx).UnderlyingDB()，
// 返回的是全局连接而非当前事务！
//
// 后果：
//   - 事务回滚对其写入无效（数据写入全局连接）
//   - 查询会看到数据库中所有已有数据（包括其他测试的数据）
//   - Cipher 解密失败（看到旧 cipher key 加密的记录）
//
// 错误示例：
//   rows, _ := q.User.WithContext(ctx).UnderlyingDB().Rows()
//
// 正确示例：
//   users, _ := q.User.Where(q.User.Name.Eq("test-prefix")).All()
//
// 应对策略：
//   - 通过唯一前缀（如 CompanyName 前缀）+ 查询过滤条件
//   - 将查询结果限定在本次测试创建的数据范围内
//   - 不依赖事务隔离

// ⚠️ 唯一约束字段
//
// 模型中有唯一约束的字段（如 fleet_id）在测试辅助函数中必须生成唯一值，
// 否则多条测试数据插入时会因重复值报错。
//
// 推荐方式：
//   FleetId: fmt.Sprintf("fleet-%d", time.Now().UnixNano())
