// ============================================================================
// 错误 1：Delta Testing - 假设数据库为空
// ============================================================================

// ❌ 错误示例：使用绝对数量断言
func DeltaTesting_WrongWay() {
	// 创建 3 个 API resources
	for i := 1; i <= 3; i++ {
		// testTx.Create(resource)
	}

	// ❌ 期望绝对数量是 3
	// resources, _ := svc.ListApiResource(testCtx)
	// Expect(len(resources)).To(Equal(3))  // 失败：实际是 174（生产数据 + 测试数据）
}

// ✅ 正确示例：使用差值验证
func DeltaTesting_CorrectWay() {
	// ✅ 获取创建前的数量
	// beforeResources, _ := svc.ListApiResource(testCtx)
	// beforeCount := len(beforeResources)  // 假设是 171

	// 创建 3 个 API resources
	for i := 1; i <= 3; i++ {
		// testTx.Create(resource)
	}

	// ✅ 验证增加了 3 个
	// resources, _ := svc.ListApiResource(testCtx)
	// afterCount := len(resources)  // 现在是 174
	// Expect(afterCount - beforeCount).To(Equal(3))  // ✅ 174 - 171 = 3
}

// ============================================================================
// 错误 2：不必要的 Cleanup 代码（反模式）
// ============================================================================

// ❌ 错误示例：手动清理所有表
func UnnecessaryCleanup_WrongWay() {
	ginkgo.BeforeEach(func() {
		// ❌ 反模式：手动清理所有表
		// testQ.User.Unscoped().Where(testQ.User.ID.Gte(0)).Delete()
		// testQ.Role.Unscoped().Where(testQ.Role.ID.Gte(0)).Delete()
		// testQ.UserRoleRel.Unscoped().Where(testQ.UserRoleRel.ID.Gte(0)).Delete()
		// ... 更多表的清理
	})
}

// ✅ 正确示例：只依赖事务回滚
func UnnecessaryCleanup_CorrectWay() {
	var testTx *gorm.DB
	var testQ *query.Query

	ginkgo.BeforeEach(func() {
		// ✅ 只启动事务
		testTx = gormclient.GetDB(context.Background()).Begin()
		testQ = query.Use(testTx)
		// ... 创建测试数据
	})

	ginkgo.AfterEach(func() {
		// ✅ 只回滚事务
		if testTx != nil {
			_ = testTx.Rollback()  // 自动清理所有测试数据
		}
	})
}

