package mypkg

import (
	"testing"

	"github.com/joho/godotenv"
	"github.com/onsi/ginkgo/v2"
	. "github.com/onsi/gomega"
	"source.golabs.io/fleet/fleet-backend/client/gormclient"
	"source.golabs.io/fleet/fleet-backend/config"
	"source.golabs.io/fleet/fleet-backend/migrations"
)

// repoRoot returns the absolute path to the repository root directory.
// Uses the unified migrations.RepoRoot() function to ensure consistency
// across all test packages and environments (local/CI).
func repoRoot() string {
	return migrations.RepoRoot()
}

var _ = ginkgo.BeforeSuite(func() {
	_ = godotenv.Load(repoRoot() + "/.env.local")
	config.InitConfig("")
	gormclient.InitGormClientWithMigration(nil)
})

func TestSuite(t *testing.T) {
	RegisterFailHandler(ginkgo.Fail)
	ginkgo.RunSpecs(t, "MyPkg Suite")
}
