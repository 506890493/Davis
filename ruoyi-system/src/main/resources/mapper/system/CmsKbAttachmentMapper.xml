<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.CmsKbAttachmentMapper">

    <resultMap type="CmsKbAttachment" id="BaseResultMap">
        <id     property="id"          column="id"/>
        <result property="documentId"  column="document_id"/>
        <result property="versionId"   column="version_id"/>
        <result property="fileId"      column="file_id"/>
        <result property="displayName" column="display_name"/>
        <result property="sortNum"     column="sort_num"/>
        <result property="createBy"    column="create_by"/>
        <result property="createTime"  column="create_time"/>
        <result property="updateBy"    column="update_by"/>
        <result property="updateTime"  column="update_time"/>
        <result property="remark"      column="remark"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, document_id, version_id, file_id, display_name, sort_num,
        create_by, create_time, update_by, update_time, remark
    </sql>

    <select id="selectByDocument" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM cms_kb_attachment
        WHERE document_id = #{documentId}
        ORDER BY sort_num, id
    </select>

    <insert id="insert" parameterType="CmsKbAttachment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cms_kb_attachment(document_id, version_id, file_id, display_name, sort_num,
                                      create_by, create_time, update_by, update_time, remark)
        VALUES(#{documentId}, #{versionId}, #{fileId}, #{displayName}, #{sortNum},
               #{createBy}, sysdate(), #{updateBy}, sysdate(), #{remark})
    </insert>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM cms_kb_attachment WHERE id = #{id}
    </delete>

    <delete id="hardDeleteByDocument" parameterType="Long">
        DELETE FROM cms_kb_attachment WHERE document_id = #{documentId}
    </delete>
</mapper>
